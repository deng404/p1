<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <!-- Lab1 Top Text -->
    <TextView
        android:id="@+id/tvLab1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lab 1"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:gravity="center"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- White Card Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tvLab1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/tvResponsiveTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Responsive Layout 1"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="20dp"
            app:layout_constraintTop_toTopOf="cardContainer"/>

        <!-- Four weighted coloured views inside ConstraintLayout -->
        <TextView
            android:id="@+id/tvThis"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:background="#ff0000"
            android:text="This"
            android:textColor="#FFFFFF"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tvResponsiveTitle"
            app:layout_constraintStart_toStartOf="cardContainer"
            app:layout_constraintEnd_toStartOf="@id/tvIs"
            app:layout_constraintHorizontal_weight="1"/>

        <TextView
            android:id="@+id/tvIs"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:background="#0000ff"
            android:text="is"
            android:textColor="#FFFFFF"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tvResponsiveTitle"
            app:layout_constraintStart_toEndOf="@id/tvThis"
            app:layout_constraintEnd_toStartOf="@id/tvMy"
            app:layout_constraintHorizontal_weight="1"/>

        <TextView
            android:id="@+id/tvMy"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:background="#8040b0"
            android:text="my"
            android:textColor="#FFFFFF"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tvResponsiveTitle"
            app:layout_constraintStart_toEndOf="@id/tvIs"
            app:layout_constraintEnd_toStartOf="@id/tvFirst"
            app:layout_constraintHorizontal_weight="1"/>

        <TextView
            android:id="@+id/tvFirst"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:background="#ffff00"
            android:text="first"
            android:textColor="#000000"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tvResponsiveTitle"
            app:layout_constraintStart_toEndOf="@id/tvMy"
            app:layout_constraintEnd_toEndOf="cardContainer"
            app:layout_constraintHorizontal_weight="1"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Middle text: Android Application -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="Android Application"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/cardContainer"
        app:layout_constraintBottom_toTopOf="@id/layoutButtons"/>

    <!-- Two Buttons at bottom -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/btnChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change"
            android:backgroundTint="#7b5bb0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCancel"/>

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:backgroundTint="#7b5bb0"
            app:layout_constraintStart_toEndOf="@id/btnChange"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
